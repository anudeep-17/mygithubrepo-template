# .env.example
#
# Purpose:
# This file lists every environment variable needed by the project.
# Never put real secrets here.
# Copy this file to `.env.local` for local development.

# ----------------------------------------
# App
# ----------------------------------------

NEXT_PUBLIC_APP_URL=http://localhost:3000
NODE_ENV=development

# ----------------------------------------
# Database
# ----------------------------------------

DATABASE_URL=

# ----------------------------------------
# Authentication
# ----------------------------------------

NEXT_PUBLIC_AUTH_URL=
NEXT_PUBLIC_AUTH_ANON_KEY=
AUTH_SECRET_KEY=
AUTH_SERVICE_ROLE_KEY=

# ----------------------------------------
# CMS
# ----------------------------------------

NEXT_PUBLIC_CMS_PROJECT_ID=
NEXT_PUBLIC_CMS_DATASET=
CMS_API_TOKEN=

# ----------------------------------------
# Payments
# ----------------------------------------

NEXT_PUBLIC_PAYMENT_PUBLISHABLE_KEY=
PAYMENT_SECRET_KEY=
PAYMENT_WEBHOOK_SECRET=

# ----------------------------------------
# Email
# ----------------------------------------

EMAIL_API_KEY=
EMAIL_FROM=

# ----------------------------------------
# Storage
# ----------------------------------------

STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=
STORAGE_BUCKET=
STORAGE_REGION=

# ----------------------------------------
# Analytics
# ----------------------------------------

NEXT_PUBLIC_ANALYTICS_ID=

# ----------------------------------------
# Feature Flags
# ----------------------------------------

NEXT_PUBLIC_ENABLE_EXAMPLE_FEATURE=false
